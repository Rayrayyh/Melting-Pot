# Supabase project URL and anon (publishable) key. The anon key is safe to
# expose: row level security is the enforcement layer.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Identity provider. Unset or "supabase" uses Supabase Auth, which is the only
# implemented provider. "clerk" selects the framework slot in lib/auth/clerk.ts,
# which is deliberately unimplemented. See docs/AUTH.md.
NEXT_PUBLIC_AUTH_PROVIDER=

# Server-only key for the model that mixes notes into study material. Never
# prefix this with NEXT_PUBLIC_. Without it, and without both model names
# below, the deterministic organizer carries every flow and the study tools
# report that mixing is unavailable.
MODEL_API_KEY=
# Model identifiers belong to the provider and change on their schedule, so
# they are configuration rather than source. FAST_MODEL handles organizing,
# summaries and decks; REASONING_MODEL writes practice tests.
FAST_MODEL=gemini-3.7-flash
REASONING_MODEL=gemini-3.1-pro-preview
