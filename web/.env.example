# Supabase project URL and anon (publishable) key. The anon key is safe to
# expose: row level security is the enforcement layer.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Set to "on" to show the "Continue with Google" button, once the Google
# provider is configured in the Supabase dashboard. Off by default so the
# button never appears in a state where pressing it fails.
# See docs/GOOGLE-SIGN-IN.md.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=
