# Supabase project URL and anon (publishable) key. The anon key is safe to
# expose: row level security is the enforcement layer.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Identity provider. Unset or "supabase" uses Supabase Auth, which is the only
# implemented provider. "clerk" selects the framework slot in lib/auth/clerk.ts,
# which is deliberately unimplemented. See docs/AUTH.md.
NEXT_PUBLIC_AUTH_PROVIDER=

# Server-only Google Gemini key. Never prefix this with NEXT_PUBLIC_.
# Without it the deterministic organizer carries every flow and the study
# tools report that generation is unavailable.
GEMINI_API_KEY=
GEMINI_FLASH_MODEL=gemini-3.7-flash
GEMINI_REASONING_MODEL=gemini-3.1-pro-preview
